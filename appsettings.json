{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Jwt": {
    "Issuer": "RondiTrack",
    "Audience": "RondiTrack.Api",
    "AccessTokenMinutes": 15,
    "ClockSkewSeconds": 30,
    "RefreshTokenDays": 7
  },

  "Health": {
    "ReadyTimeoutSeconds": 2
  },

  "Cors": {
    "AllowedOrigins": []
  }
}