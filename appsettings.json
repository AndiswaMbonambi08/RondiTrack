{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Jwt": {
    "Issuer": "RondiTrack",
    "Audience": "RondiTrack.Api",
    "AccessTokenMinutes": 15,
    "ClockSkewSeconds": 30,
    "RefreshTokenDays": 7
  },

  "Health": {
    "ReadyTimeoutSeconds": 2
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "RateLimit": {
    "Login": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "RecordContribution": {
      "TokenLimit": 30,
      "TokensPerPeriod": 1,
      "ReplenishSeconds": 10
    },
    "ProcessPayout": {
      "TokenLimit": 5,
      "TokensPerPeriod": 1,
      "ReplenishSeconds": 30
    }
  },

  "Docs": {
    "Enabled": true
  },

  "Seed": {
    "Enabled": true
  },

  "CycleClose": {
    "Enabled": true,
    "IntervalMinutes": 15,
    "TimeZoneId": "Africa/Johannesburg",
    "CycleEndDay": 25
  },

  "Housekeeping": {
    "Enabled": true,
    "IntervalMinutes": 60,
    "RefreshTokenRetentionDays": 30,
    "IdempotencyRetentionHours": 168
  }
}