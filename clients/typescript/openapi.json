    "/api/v1/stokvels/{id}/contributions": {
      "post": {
        "tags": [
          "Stokvels"
        ],
        "summary": "Record a member's contribution for a cycle",
        "description": "Members may record their own contribution. Treasurer or Admin may record anyone's (403 otherwise).\r\nRequires an Idempotency-Key header, scoped to the caller and the stokvel. Repeating the same key\r\nwith the same body returns the original response unchanged, with an Idempotency-Replayed: true\r\nheader. Repeating the same key with a different body returns 422.\r\nRate limited per user (429 with Retry-After). A 429 never consumes the key, so retry with the\r\nsame key after the wait.\r\nFails 404 if the stokvel, user, or contribution cycle does not exist, or if the cycle belongs\r\nto a different stokvel. Fails 409 if the user is not a member, or has already contributed for\r\nthis cycle.\r\nExample request:\r\n{ \"userId\": \"...\", \"contributionCycleId\": \"...\", \"amount\": 500 }",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecordContributionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContributionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
