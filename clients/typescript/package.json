{
  "name": "ronditrack-client-types",
  "private": true,
  "type": "module",
  "scripts": {
    "fetch": "node scripts/fetch-openapi.mjs",
    "gen": "openapi-typescript openapi.json -o src/api.d.ts",
    "check": "tsc --noEmit --strict",
    "verify": "npm run gen && npm run check"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
